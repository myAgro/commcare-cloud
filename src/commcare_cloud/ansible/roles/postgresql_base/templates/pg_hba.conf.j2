{{ ansible_managed|comment }}

# -------------------------------------------------------------------
# Helper: resolve hostname → IPv4 safely (never emit NXDOMAIN)
# -------------------------------------------------------------------
{% macro resolve_ip(host) -%}
{{ host if host | ipaddr else (lookup('dig', host, wantlist=True) | first | default('')) }}
{%- endmacro %}

# -------------------------------------------------------------------
# Local connections
# -------------------------------------------------------------------

# Database administrative login by Unix domain socket
local   all             postgres                                peer

# Allow replication connections from localhost
local   replication     postgres                                peer

# "local" is for Unix domain socket connections only
local   all             all                                     peer

# IPv4 local connections
host    all             all             127.0.0.1/32            md5

# IPv6 local connections
host    all             all             ::1/128                 md5

# -------------------------------------------------------------------
# Custom HBA entries (explicit CIDRs only)
# -------------------------------------------------------------------

{% for entry in postgresql_hba_entries %}
{% if entry.contype|default('host') == 'local' %}
local   {{ entry.databases|default('all') }}   {{ entry.users|default('all') }}   {{ entry.method|default('md5') }}
{% else %}
{% if entry.netmask is defined and entry.netmask | ipaddr %}
host    {{ entry.databases|default('all') }}   {{ entry.users|default('all') }}   {{ entry.netmask }}   {{ entry.method|default('md5') }}
{% else %}
# Skipped invalid HBA entry (invalid netmask): {{ entry }}
{% endif %}
{% endif %}
{% endfor %}

# -------------------------------------------------------------------
# Standby replication (safe DNS resolution)
# -------------------------------------------------------------------

{% for standby in groups.get('pg_standby', []) %}
{% if hostvars[standby].hot_standby_master | default(None) == inventory_hostname %}
{% set ip = resolve_ip(standby) %}
{% if ip | ipaddr %}
host    replication   {{ postgres_users.replication.username | default('hqrepl') }}   {{ ip }}/32   md5
{% else %}
# Skipped standby {{ standby }} (DNS resolution failed)
{% endif %}
{% endif %}
{% endfor %}

# -------------------------------------------------------------------
# Citus cluster rules
# -------------------------------------------------------------------

{% if inventory_hostname in groups.get('citusdb_worker', []) %}

# Allow trust from localhost for PgBouncer
host    all     all     127.0.0.1/32        trust
host    all     all     ::1/128             trust

# Allow trust from citus masters
{% for host in groups.get('citusdb_master', []) %}
{% set ip = resolve_ip(host) %}
{% if ip | ipaddr %}
host    all     all     {{ ip }}/32         trust
{% else %}
# Skipped citus master {{ host }} (DNS failed)
{% endif %}
{% endfor %}

# Allow replication between citus workers
{% for host in groups.get('citusdb_worker', []) | difference([inventory_hostname]) %}
{% set ip = resolve_ip(host) %}
{% if ip | ipaddr %}
host    replication   {{ postgres_users.replication.username | default('hqrepl') }}   {{ ip }}/32   md5
{% else %}
# Skipped citus worker {{ host }} (DNS failed)
{% endif %}
{% endfor %}

{% endif %}

# -------------------------------------------------------------------
# PgBouncer access
# -------------------------------------------------------------------

{% for db in postgresql_dbs.all %}
{% if db.host == inventory_hostname %}
{% for host in db.pgbouncer_hosts %}
{% set ip = resolve_ip(host) %}
{% if ip | ipaddr %}
host    all     all     {{ ip }}/32         trust
{% else %}
# Skipped PgBouncer host {{ host }} (DNS failed)
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}

# -------------------------------------------------------------------
# Formplayer access
# -------------------------------------------------------------------

{% for db in postgresql_dbs.all %}
{% if db.host == inventory_hostname and db.name == 'formplayer' %}
{% for host in groups.formplayer %}
{% set ip = resolve_ip(host) %}
{% if ip | ipaddr %}
host    all     all     {{ ip }}/32         trust
{% else %}
# Skipped Formplayer host {{ host }} (DNS failed)
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
